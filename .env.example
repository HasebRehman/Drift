# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Private site access (server only; never prefix these with NEXT_PUBLIC_).
# Set actual values in .env.local and your hosting dashboard, not this file.
# Minimum 12 characters for the password; minimum 32 characters for the secret.
SITE_PASSWORD=
SITE_ACCESS_SECRET=

# Instagram API with Instagram Login (private server credentials)
# User ID is optional: omit it to use the account authorized by the token.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
